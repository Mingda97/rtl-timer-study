read_verilog -sv -DSYNTHESIS -I"sources/uart/rtl" "sources/uart/rtl/uart_rx.v"
chparam -set DATA_WIDTH 8 uart_rx
hierarchy -check -top uart_rx
rename -top uart_rx
synth -top uart_rx -flatten -noabc
# Remove hierarchy metadata, retaining all circuit cells and net names.
delete t:$scopeinfo
dffunmap
clean
check -assert
write_rtlil build/uart_rx/common.il
write_json build/uart_rx/common.json
